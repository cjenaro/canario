{
  "name": "canario-app",
  "version": "0.1.2",
  "description": "Canario — cross-platform voice-to-text desktop app",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev -- --no-sandbox --disable-gpu-sandbox",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "stage:sidecar": "node scripts/stageSidecar.cjs",
    "package:linux": "npm run stage:sidecar && electron-builder --linux AppImage deb --publish never && node scripts/patchAppImage.cjs dist"
  },
  "keywords": [],
  "author": "Jenaro",
  "homepage": "https://github.com/cjenaro/canario",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@jitsi/robotjs": "^0.6.22",
    "@motionone/dom": "^10.18.0",
    "@tanstack/solid-virtual": "^3.13.38",
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.6.0",
    "concurrently": "^9.2.1",
    "electron": "^41.2.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "6.0.0-beta.1",
    "solid-js": "^1.9.12",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.8",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "5.0.0",
    "wait-on": "^9.0.5"
  }
}
